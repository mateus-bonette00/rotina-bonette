{
  "name": "rotina-bonette-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/with-env.mjs tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node scripts/with-env.mjs node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "node scripts/with-env.mjs prisma migrate dev",
    "db:deploy": "node scripts/with-env.mjs prisma migrate deploy",
    "db:seed": "node scripts/with-env.mjs tsx prisma/seed.ts",
    "setup": "node scripts/with-env.mjs tsx src/setup.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "argon2": "^0.43.0",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "rotina-bonette-shared": "*",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.18",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.2",
    "@types/node": "^22.15.30",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.9.0",
    "supertest": "^7.1.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
