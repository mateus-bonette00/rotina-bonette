# Copie para .env e troque os segredos antes de usar fora desta máquina.
POSTGRES_USER=rotina
POSTGRES_PASSWORD=rotina_local_dev
POSTGRES_DB=rotina_bonette
DATABASE_URL=postgresql://rotina:rotina_local_dev@127.0.0.1:5432/rotina_bonette?schema=public

API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://127.0.0.1:5173

# Mínimo 16 caracteres. Gere outro valor se mais alguém usar esta máquina.
SESSION_SECRET=dev-only-change-me-please-32chars
SESSION_IDLE_HOURS=12
NODE_ENV=development

# Opcional, só no setup. Apague depois de criar o PIN.
# INITIAL_PIN=
